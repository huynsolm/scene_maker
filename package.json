{
  "name": "scene_maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "씬 메이커 — 텍스트와 이미지로 짧은 무음 안내 영상을 만드는 웹앱",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "seed:sample": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "compare:frame": "tsx scripts/compare-frame.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "image-size": "^2.0.4",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "form-data": "^4.0.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
